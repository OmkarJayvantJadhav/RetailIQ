# ═══════════════════════════════════════════════════════════
# RetailIQ Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retailiq_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retailiq_db

# ── JWT Authentication ────────────────────────────────────
JWT_SECRET_KEY=retailiq-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── Backend Server ────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# ── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
